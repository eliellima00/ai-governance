rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e gravação para a coleção de projetos de governança
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Permite leitura e gravação das configurações globais de governança
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Permite checagem de integridade de conexão
    match /test/{testId} {
      allow read, write: if true;
    }

    // Bloqueia qualquer outro caminho por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
