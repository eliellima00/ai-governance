# SUPABASE: Configuração do banco relacional PostgreSQL via Supabase.
# Obtenha estas credenciais no painel do seu projeto Supabase (Project Settings > API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SUPABASE POSTGRESQL / PRISMA MIGRATE (necessário só para rodar `npm run migrate` / `migrate:dev`):
# Obtenha em Project Settings > Database > Connection string > aba "Connection pooling".
# DATABASE_URL = string da opção "Transaction pooler" (porta 6543), com "?pgbouncer=true" no final.
# DIRECT_URL   = string da opção "Session pooler" (porta 5432, mesmo host do pooler).
# Não use a aba "Direct connection" (porta 5432 em db.<ref>.supabase.co): é IPv6-only e não
# conecta em redes sem IPv6 — foi por isso que trocamos para o pooler.
DATABASE_URL=
DIRECT_URL=
